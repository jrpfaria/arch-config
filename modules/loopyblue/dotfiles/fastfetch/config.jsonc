{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 24
        },
        "type": "kitty",
        "source": "~/.config/fastfetch/loopycard.png",
        "position": "top",
        "width": 24
    },
    "display": {
        "separator": " ⟶ "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": " ───────────────────────────────────────────── "
        },
        {
            "type": "os",
            "key": "    ",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "    ",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "   󰏖 ",
            "keyColor": "green"
        },
	    {
            "type": "wm",
            "key": "    ",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "    ",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "    ",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "   󰔛 ",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "    ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": " ───────────────────────────────────────────── "
        },
        {
            "type": "cpu",
            "key": "    ",
            "keyColor": "yellow",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "    ",
            "keyColor": "yellow",
            "format": "{2}"
        },
        {
            "type": "host",
            "key": "   󰌢 ",
            "keyColor": "yellow",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "    ",
            "keyColor": "yellow",
            "format": "{1} / {2}"
        },
        {
            "type": "disk",
            "key": "    ",
            "keyColor": "yellow",
            "format": "{1} / {2} ({3}) {20}"
        },
        {
            "type": "custom",
            "format": " ───────────────────────────────────────────── "
        }
    ]
}
